<Project Sdk="Aspire.AppHost.Sdk/13.5.4">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Application, not a library: keep it out of `dotnet pack`. -->
    <IsPackable>false</IsPackable>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <UserSecretsId>a38ba06c-a565-43aa-8d88-d414751152dc</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PublicOtel.ApiService\PublicOtel.ApiService.csproj" />
    <ProjectReference Include="..\PublicOtel.Web\PublicOtel.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.DevTunnels" Version="13.5.4" />
    <PackageReference Include="Aspire.Hosting.Maui" Version="13.5.4-preview.1.26464.4" />
  </ItemGroup>

</Project>
