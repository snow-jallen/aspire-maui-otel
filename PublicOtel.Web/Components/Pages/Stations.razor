@page "/stations"
@rendermode InteractiveServer
@implements IDisposable
@using PublicOtel.ClientLogic.Realtime

@* The same StationsViewModel the MAUI Stations tab binds to, used unchanged. MAUI binds to it
   through INotifyPropertyChanged automatically; Blazor does not, so this page listens for
   the view model's change notifications and re-renders on each one. *@
@inject StationsViewModel ViewModel

<PageTitle>Stations</PageTitle>

<h1>Live station readings</h1>

<p>
    Report a reading here and it travels as an HTTP POST to the API, where an Akka.NET actor
    handles it, then comes back to every connected client over SignalR - this page, other
    browser tabs, and the MAUI app's <strong>Stations</strong> tab. The whole journey is one
    trace in the Aspire dashboard, starting at <code>webfrontend</code>.
</p>

<div class="row g-2 mb-3" style="max-width: 28rem">
    <div class="col">
        <label class="form-label" for="station">Station</label>
        <input id="station" class="form-control" @bind="ViewModel.Station" />
    </div>
    <div class="col-4">
        <label class="form-label" for="temperature">°C</label>
        <input id="temperature" type="number" class="form-control" @bind="ViewModel.TemperatureC" />
    </div>
</div>

<button class="btn btn-secondary me-2" @onclick="() => ViewModel.ConnectCommand.ExecuteAsync(null)">Connect</button>
<button class="btn btn-primary" @onclick="() => ViewModel.ReportReadingCommand.ExecuteAsync(null)">Report Reading</button>

<p class="mt-3" role="status">@ViewModel.Status</p>

@if (ViewModel.LatestReading is { } latest)
{
    <p class="fs-4">Latest: <strong>@latest.Station @latest.TemperatureC°C</strong></p>
}

<h2 class="h5 mt-4">Pushed from the server</h2>

@if (ViewModel.Updates.Count == 0)
{
    <p><em>Nothing yet. Connect, then report a reading from here or from another device.</em></p>
}
else
{
    <ul class="list-group" style="max-width: 28rem">
        @foreach (var update in ViewModel.Updates)
        {
            <li class="list-group-item d-flex justify-content-between">
                <span><strong>@update.Station</strong> <small class="text-muted">@update.ObservedAt.ToLocalTime().ToString("T")</small></span>
                <span class="fs-5">@update.TemperatureC°C</span>
            </li>
        }
    </ul>
}

@code {
    protected override void OnInitialized()
    {
        ViewModel.PropertyChanged += OnViewModelChanged;
        ViewModel.Updates.CollectionChanged += OnViewModelChanged;
    }

    // SignalR pushes arrive on a background thread. The view model posts them to the
    // synchronization context it captured, which here is this circuit's renderer, and
    // InvokeAsync makes sure the re-render happens there too.
    private void OnViewModelChanged(object? sender, EventArgs e) => _ = InvokeAsync(StateHasChanged);

    // The view model outlives this component (it is scoped to the circuit), so the handlers
    // have to come off when the page goes away, or every visit would add another.
    public void Dispose()
    {
        ViewModel.PropertyChanged -= OnViewModelChanged;
        ViewModel.Updates.CollectionChanged -= OnViewModelChanged;
    }
}
