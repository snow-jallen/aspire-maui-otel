<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PublicOtel.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:PublicOtel.Mobile"
    Title="PublicOtel.Mobile">

    <!-- Content is assigned from the DI container in AppShell.xaml.cs so MainPage can take
         constructor dependencies (the API client, telemetry, and a logger). -->
    <!-- A TabBar rather than bare ShellContent: bare items become flyout entries hidden
         behind the hamburger button, which on Windows is easy to miss entirely. -->
    <TabBar>
        <ShellContent
            x:Name="HomeContent"
            Title="Weather"
            Route="MainPage" />

        <!--#if (IncludeAkka) -->
        <ShellContent
            x:Name="StationsContent"
            Title="Stations"
            Route="StationsPage" />
        <!--#endif -->
    </TabBar>

</Shell>
