    "apiServiceHttpPortReplacer": { "type": "generated", "generator": "coalesce", "parameters": { "sourceVariableName": "apiServiceHttpPort", "fallbackVariableName": "apiServiceHttpPortGenerated" }, "replaces": "5301" },

