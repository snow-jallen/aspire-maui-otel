  "sources": [
    {
      "source": "./",
      "target": "./",
      "exclude": [
        "**/.template.config/**",
        "**/[Bb]in/**",
        "**/[Oo]bj/**",
        "**/.vs/**",
        "**/.aspire/**",
        "**/*.user",
        "**/*.lock.json",
        "**/*.feature.cs"
      ],
      "modifiers": [
        {
          "condition": "(hostIdentifier != \"dotnetcli\" && hostIdentifier != \"dotnetcli-preview\")",
          "exclude": [ "*.sln" ]
        },
        {
          "condition": "(!IncludeAkka)",
          "exclude": [
            "PublicOtel.ApiService/Actors/**",
            "PublicOtel.ApiService/Hubs/**",
            "PublicOtel.ApiService/Telemetry/**",
            "PublicOtel.ClientLogic/Realtime/**",
            "PublicOtel.ClientTests/Actors/**",
            "PublicOtel.ClientTests/Realtime/**",
            "PublicOtel.ClientTests/Features/Stations.feature",
            "PublicOtel.ClientTests/Steps/StationSteps.cs",
            "PublicOtel.Mobile/StationsPage.xaml",
            "PublicOtel.Mobile/StationsPage.xaml.cs"
          ]
        }
      ]
    }
  ],
  "forms": {
    "stripNonAlphanumeric": {
      "identifier": "replace",
      "pattern": "[^a-zA-Z0-9]",
      "replacement": ""
    },
    "androidAppIdSegment": {
      "identifier": "chain",
      "steps": [ "lowerCaseInvariant", "stripNonAlphanumeric" ]
    }
  },
  "symbols": {
    "hostIdentifier": { "type": "bind", "binding": "HostIdentifier" },

    "IncludeAkka": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "displayName": "Include Akka.NET actors and SignalR",
      "description": "Adds an Akka.NET actor system to the API service via Akka.Hosting, a message envelope carrying ActivityContext so traces survive the actor mailbox, and a SignalR hub that pushes actor state changes live to the MAUI client."
    },

    "androidAppIdName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "androidAppIdSegment",
      "replaces": "APPIDNAME",
      "description": "Project name lower-cased with separators removed, for the Android ApplicationId. Dots must not survive here: each dot starts a new Java package segment, and a segment that happens to be a Java keyword makes the generated R.java fail to compile. 'Final.Check' would otherwise yield package com.companyname.final.check.mobile, and 'final' is reserved."
    },

    "applicationIdPrefix": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "com.companyname",
      "replaces": "com.companyname",
      "description": "Reverse-DNS prefix for the MAUI ApplicationId, for example com.contoso."
    },
    "lowerCaseName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "lowerCaseInvariant",
      "replaces": "publicotel",
      "description": "Lower-cased project name, used for the MAUI ApplicationId, the OpenTelemetry meter and instrument names, and the Aspire dashboard localhost TLD."
    },


    "tunnelSuffix": {
      "type": "generated",
      "generator": "random",
      "parameters": { "low": 100000, "high": 999999 },
      "replaces": "TUNNELSUFFIX",
      "description": "Random suffix baked into the dev tunnel ID at generation time, so each generated app owns a distinct tunnel that survives moving or renaming the folder."
    },

    "GeneratedClassNamePrefix": {
      "type": "generated",
      "generator": "regex",
      "datatype": "string",
      "replaces": "GeneratedClassNamePrefix",
      "parameters": {
        "source": "name",
        "steps": [
          { "regex": "(((?<=\\.)|^)(?=\\d)|\\W)", "replacement": "_" }
        ]
      },
      "description": "The project name sanitised into a C# identifier. Matches the type names the Aspire source generator emits under the Projects namespace, where dots become underscores."
    },

    "appHostHttpPort": { "type": "parameter", "datatype": "integer", "description": "Port for the AppHost HTTP endpoint in launchSettings.json." },
    "appHostHttpPortGenerated": { "type": "generated", "generator": "port", "parameters": { "low": 15000, "high": 15300 } },
    "appHostHttpPortReplacer": { "type": "generated", "generator": "coalesce", "parameters": { "sourceVariableName": "appHostHttpPort", "fallbackVariableName": "appHostHttpPortGenerated" }, "replaces": "15000" },

    "appHostHttpsPort": { "type": "parameter", "datatype": "integer", "description": "Port for the AppHost HTTPS endpoint in launchSettings.json." },
    "appHostHttpsPortGenerated": { "type": "generated", "generator": "port", "parameters": { "low": 17000, "high": 17300 } },
    "appHostHttpsPortReplacer": { "type": "generated", "generator": "coalesce", "parameters": { "sourceVariableName": "appHostHttpsPort", "fallbackVariableName": "appHostHttpsPortGenerated" }, "replaces": "17000" },

    "appHostOtlpHttpPort": { "type": "parameter", "datatype": "integer", "description": "Port for the OTLP HTTP endpoint in launchSettings.json." },
    "appHostOtlpHttpPortGenerated": { "type": "generated", "generator": "port", "parameters": { "low": 19000, "high": 19300 } },
    "appHostOtlpHttpPortReplacer": { "type": "generated", "generator": "coalesce", "parameters": { "sourceVariableName": "appHostOtlpHttpPort", "fallbackVariableName": "appHostOtlpHttpPortGenerated" }, "replaces": "19000" },

    "appHostOtlpHttpsPort": { "type": "parameter", "datatype": "integer", "description": "Port for the OTLP HTTPS endpoint in launchSettings.json." },
    "appHostOtlpHttpsPortGenerated": { "type": "generated", "generator": "port", "parameters": { "low": 21000, "high": 21300 } },
    "appHostOtlpHttpsPortReplacer": { "type": "generated", "generator": "coalesce", "parameters": { "sourceVariableName": "appHostOtlpHttpsPort", "fallbackVariableName": "appHostOtlpHttpsPortGenerated" }, "replaces": "21000" },

    "appHostResourceHttpPort": { "type": "parameter", "datatype": "integer", "description": "Port for the resource service HTTP endpoint in launchSettings.json." },
    "appHostResourceHttpPortGenerated": { "type": "generated", "generator": "port", "parameters": { "low": 20000, "high": 20300 } },
    "appHostResourceHttpPortReplacer": { "type": "generated", "generator": "coalesce", "parameters": { "sourceVariableName": "appHostResourceHttpPort", "fallbackVariableName": "appHostResourceHttpPortGenerated" }, "replaces": "20000" },

