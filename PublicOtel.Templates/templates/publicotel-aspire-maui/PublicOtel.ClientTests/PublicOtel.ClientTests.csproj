<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xUnit1051 wants TestContext.Current.CancellationToken threaded through every awaited
         call. Akka TestKit's ExpectMsg/EventFilter own their own timeouts, and the substituted
         async calls in these tests complete synchronously, so the token would be ceremony. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <!-- 3.2.2, not 3.0.1: Akka.TestKit.Xunit 1.5.71 depends on the 3.2.2 xunit.v3
         extensibility and assert assemblies. Reqnroll.xUnit.v3 3.3.4 asks only for >= 2.0.0
         of the same assemblies, so it is satisfied by this. -->
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <!-- Reqnroll.xUnit targets xUnit v2; the .v3 package is the one that matches xunit.v3. -->
    <PackageReference Include="Reqnroll.xUnit.v3" Version="3.3.4" />
    <!--#if (IncludeAkka) -->
    <!-- Akka.TestKit.Xunit is the xUnit *v3* TestKit, despite reading like the v1-era
         package. Akka.TestKit.Xunit2 is the xUnit v2 one; there is no Akka.TestKit.Xunit3. -->
    <PackageReference Include="Akka.TestKit.Xunit" Version="1.5.71" />
    <!--#endif -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PublicOtel.ClientLogic\PublicOtel.ClientLogic.csproj" />
    <!--#if (IncludeAkka) -->
    <ProjectReference Include="..\PublicOtel.ApiService\PublicOtel.ApiService.csproj" />
    <!--#endif -->
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
    <Using Include="NSubstitute" />
  </ItemGroup>

</Project>
