<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>PublicOtel.Templates</PackageId>
    <Version>1.12.0</Version>
    <Title>Aspire + .NET MAUI + OpenTelemetry templates</Title>
    <Authors>PublicOtel</Authors>
    <Description>Template pack for an Aspire solution with an API service, a Blazor web frontend, a .NET MAUI client wired for OpenTelemetry, shared service defaults, and an integration test project.</Description>
    <PackageTags>dotnet-new;templates;aspire;maui;opentelemetry</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <TargetFramework>net10.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <EnableDefaultItems>false</EnableDefaultItems>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>

    <!--
      NU5128: no lib/ or ref/ assemblies, which is expected for a template pack.
      NU5110/NU5111: NuGet assumes a .ps1 outside tools/ is a package install script.
        scripts/run-android.ps1 is template content that gets copied into the generated
        app, not something NuGet should ever execute.
    -->
    <NoWarn>$(NoWarn);NU5128;NU5110;NU5111</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- NoDefaultExcludes above is what lets the .template.config folder into the package;
         NuGet otherwise drops dot-prefixed directories. Build output is excluded here
         rather than relying on it never existing. -->
    <Content Include="templates\**\*"
             Exclude="templates\**\bin\**;templates\**\obj\**;templates\**\.vs\**" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
